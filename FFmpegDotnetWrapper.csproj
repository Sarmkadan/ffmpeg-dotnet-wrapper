<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FFmpegDotnetWrapper</RootNamespace>
    <AssemblyName>FFmpegDotnetWrapper</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- NuGet Package Info -->
    <PackageId>Zaiets.ffmpeg.dotnet.wrapper</PackageId>
    <Version>2.0.2</Version>
    <Authors>Vladyslav Zaiets</Authors>
    <Description>Strongly-typed FFmpeg wrapper for .NET - transcode, trim, merge, watermark with fluent API</Description>
    <PackageTags>ffmpeg video transcoding media streaming dotnet wrapper</PackageTags>
    <Copyright>Copyright © 2025 Vladyslav Zaiets</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/sarmkadan/ffmpeg-dotnet-wrapper</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sarmkadan/ffmpeg-dotnet-wrapper</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="examples/**/*.cs" />
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="src/Api/Controllers/**/*.cs" />
    <Compile Remove="src/Middleware/**/*.cs" />
    <Compile Remove="src/Program.cs" />
    <Compile Remove="src/Configuration/ApplicationStartup.cs" />
    <Compile Remove="src/Cli/OutputFormatter.cs" />
    <Compile Remove="src/Serialization/JsonOutputFormatter.cs" />
    <Compile Remove="src/Services/BatchOperationService.cs" />
    <Compile Remove="src/Services/FFmpegService.cs" />
    <Compile Remove="src/Utilities/ProgressTracker.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
  </ItemGroup>

</Project>
