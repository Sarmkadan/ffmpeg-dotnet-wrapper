<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>2.0.2</Version>
    <IsPackable>false</IsPackable>
    <!--
      Test-only relaxation of TreatWarningsAsErrors. These codes still show as warnings, they just don't fail the build:
      - CS8600/CS8602/CS8604/CS8605/CS8620/CS8625: nullable warnings from tests that pass null on purpose to
        exercise ArgumentNullException and validation paths. Annotating each call with null! would hide that intent.
      - CA1416: tests call File.SetUnixFileMode, which is Unix-only and is not platform-guarded in the test code.
      - xUnit1031: some progress-tracker tests block on tasks synchronously; they are not async-deadlock risks here.
      - xUnit2013: Assert.Equal used for collection counts in older tests; the assertion is correct as written.
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS8600;CS8602;CS8604;CS8605;CS8620;CS8625;CA1416;xUnit1031;xUnit2013</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="7.0.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../FFmpegDotnetWrapper.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../appsettings.example.json" Link="appsettings.example.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
